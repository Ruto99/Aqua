+std::string UIShader::NewShaderSource() {
+    return R"(// UI のシェーダー: effect() で色を変える。color はふだん描かれる色
+//   uTime（秒）・LocalUV()（ウィジェットの中の 0〜1）・SampleTexture(uv)・Luma(rgb)・HueShift(rgb, 0〜1)・Noise(vec2) が使える
+//   @param で調整できる値を作る（ウィジェットごとに変えられ、アニメーションもできる。最大 6 個）
+//     // @param 名前 float 最小 最大 既定値 表示名
+//     // @param 名前 vec2 最小 最大 x y 表示名
+//     // @param 名前 color r g b a 表示名
+//     // @param 名前 toggle 既定値 表示名
+// @param strength float 0 1 1 強さ
+vec4 effect(vec4 color) {
+    vec3 inverted = vec3(1.0) - color.rgb;
+    return vec4(mix(color.rgb, inverted, strength), color.a);
+}
+)";
+}
