+constexpr double kShownAgainAfter = 0.25; // これより長く描かれなかったら「表示し直した」とみなす
+
+enum EffectBit : uint32_t {
+    kWave = 1u << 0,
+    kShake = 1u << 1,
+    kRainbow = 1u << 2,
+    kPulse = 1u << 3,
+    kSwing = 1u << 4,
+    kGlitch = 1u << 5,
+};
+
+uint32_t EffectBitOf(TextEffect e) {
+    switch (e) {
+    case TextEffect::Wave: return kWave;
+    case TextEffect::Shake: return kShake;
+    case TextEffect::Rainbow: return kRainbow;
+    case TextEffect::Pulse: return kPulse;
+    case TextEffect::Swing: return kSwing;
+    case TextEffect::Glitch: return kGlitch;
+    default: return 0;
+    }
+}
+
+uint32_t EffectBitOf(std::string_view tag) {
+    if (tag == "wave") return kWave;
+    if (tag == "shake") return kShake;
+    if (tag == "rainbow") return kRainbow;
+    if (tag == "pulse") return kPulse;
+    if (tag == "swing") return kSwing;
+    if (tag == "glitch") return kGlitch;
+    return 0;
+}
