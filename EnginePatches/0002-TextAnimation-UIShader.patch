new file mode 100644
index 0000000..0d575e8
--- /dev/null
+++ b/Modules/Engine/src/UIShader.cpp
@@ -0,0 +1,392 @@
+// UI のシェーダー（.uishader）: effect() を標準のフラグメントシェーダーに組み込んでコンパイルする
+
+#include "Ruto/Engine/UIShader.h"
+
+#include "Ruto/Core/FileSystem.h"
+#include "Ruto/Core/Log.h"
+#include "Ruto/Engine/Assets.h"
+#include "Ruto/Graphics/Renderer2D.h"
+#include "Ruto/Graphics/Shader.h"
+#include "Ruto/Platform/Platform.h"
+
+#include <algorithm>
+#include <cctype>
+#include <filesystem>
+#include <format>
+#include <sstream>
+#include <unordered_map>
+
+namespace Ruto {
+
+namespace {
+
+// effect() の前に入るもの（組み込みの uniform と便利な関数）
+constexpr const char* kHelpers = R"(
+uniform float uTime;
+uniform vec4 uRect;
+uniform vec2 uScreenSize;
+uniform vec4 uParams[6];
+
+// ウィジェットの中の位置（0〜1、左上が原点）
+vec2 LocalUV() {
+    vec2 p = (gl_FragCoord.xy - uRect.xy) / max(uRect.zw, vec2(1.0));
+    return vec2(p.x, 1.0 - p.y);
+}
+// ウィジェットの中の位置（ピクセル、左上が原点）
+vec2 LocalPixel() { return LocalUV() * uRect.zw; }
+// 画面の中の位置（0〜1、左下が原点）
+vec2 ScreenUV() { return gl_FragCoord.xy / max(uScreenSize, vec2(1.0)); }
+float Luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }
+// 色相を回す（shift: 0〜1 で 1 周）
+vec3 HueShift(vec3 c, float shift) {
+    const mat3 toYIQ = mat3(0.299, 0.596, 0.211, 0.587, -0.274, -0.523, 0.114, -0.322, 0.312);
+    const mat3 toRGB = mat3(1.0, 1.0, 1.0, 0.956, -0.272, -1.106, 0.621, -0.647, 1.703);
+    vec3 yiq = toYIQ * c;
+    float h = atan(yiq.z, yiq.y) + shift * 6.28318530718;
+    yiq.yz = vec2(cos(h), sin(h)) * length(yiq.yz);
+    return toRGB * yiq;
+}
+float Hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123); }
+float Noise(vec2 p) {
+    vec2 i = floor(p);
+    vec2 f = fract(p);
+    vec2 u = f * f * (3.0 - 2.0 * f);
+    return mix(mix(Hash(i), Hash(i + vec2(1.0, 0.0)), u.x), mix(Hash(i + vec2(0.0, 1.0)), Hash(i + vec2(1.0, 1.0)), u.x), u.y);
+}
+)";
+
+// main の始まりと終わり（間に @param の値を入れる行が入る）
+constexpr const char* kMainBegin = R"(
+void main() {
+)";
+constexpr const char* kMainEnd = R"(    FragColor = effect(SampleTexture(vUV) * vColor);
+    if (FragColor.a <= 0.001) discard;
+}
+)";
+
+bool IsIdentifier(std::string_view s) {
+    if (s.empty() || !(std::isalpha(static_cast<unsigned char>(s[0])) || s[0] == '_')) return false;
+    return std::all_of(s.begin(), s.end(), [](char c) { return std::isalnum(static_cast<unsigned char>(c)) || c == '_'; });
+}
