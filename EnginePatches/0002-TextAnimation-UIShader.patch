+
+bool ParseHexColor(std::string_view s, Vec4& out) {
+    if (!s.empty() && s.front() == '#') s.remove_prefix(1);
+    if (s.size() != 6 && s.size() != 8) return false;
+    auto hex = [&](size_t i) -> int {
+        const std::string part(s.substr(i, 2));
+        char* end = nullptr;
+        const long v = std::strtol(part.c_str(), &end, 16);
+        return end && *end == '\0' ? static_cast<int>(v) : -1;
+    };
+    int c[4] = {hex(0), hex(2), hex(4), s.size() == 8 ? hex(6) : 255};
+    for (int v : c) {
+        if (v < 0) return false;
+    }
+    out = {c[0] / 255.0f, c[1] / 255.0f, c[2] / 255.0f, c[3] / 255.0f};
+    return true;
+}
+
+bool ParseNumber(std::string_view s, float& out) {
+    const std::string str(s);
+    char* end = nullptr;
+    out = std::strtof(str.c_str(), &end);
+    return end && *end == '\0' && !str.empty();
+}
+
+// 文字とタグを分ける
+std::vector<Char> Parse(std::string_view text, bool rich) {
+    std::vector<Char> out;
+    struct Open {
+        std::string name;
+        uint32_t bit = 0;
+        Vec4 color{};
+        float value = 1.0f;
+    };
+    std::vector<Open> stack;
+    float pendingPause = 0.0f;
+    auto current = [&](Char& c) {
+        for (const Open& o : stack) {
+            c.effects |= o.bit;
+            if (o.name == "color") {
+                c.hasColor = true;
+                c.color = o.color;
+            } else if (o.name == "alpha") {
+                c.alpha *= o.value;
+            } else if (o.name == "speed") {
+                c.speed *= o.value;
+            }
+        }
+    };
+    size_t i = 0;
+    while (i < text.size()) {
+        if (rich && text[i] == '<') {
+            const size_t close = text.find('>', i + 1);
+            if (close != std::string_view::npos && close - i < 48) {
+                std::string_view tag = text.substr(i + 1, close - i - 1);
+                bool handled = false;
+                if (!tag.empty() && tag.front() == '/') {
+                    // 閉じるタグ（</> なら直前のもの）
+                    const std::string_view name = tag.substr(1);
+                    for (size_t k = stack.size(); k-- > 0;) {
+                        if (name.empty() || stack[k].name == name) {
+                            stack.erase(stack.begin() + static_cast<std::ptrdiff_t>(k));
+                            handled = true;
+                            break;
+                        }
+                    }
+                } else {
+                    const size_t eq = tag.find('=');
+                    const std::string_view name = tag.substr(0, eq);
+                    const std::string_view value = eq == std::string_view::npos ? std::string_view() : tag.substr(eq + 1);
+                    float number = 0.0f;
+                    Vec4 color{};
+                    if (const uint32_t bit = EffectBitOf(name); bit && value.empty()) {
+                        stack.push_back({std::string(name), bit});
+                        handled = true;
+                    } else if (name == "color" && ParseHexColor(value, color)) {
+                        stack.push_back({"color", 0, color});
+                        handled = true;
+                    } else if ((name == "alpha" || name == "speed") && ParseNumber(value, number)) {
+                        stack.push_back({std::string(name), 0, {}, std::max(number, name == "speed" ? 0.01f : 0.0f)});
+                        handled = true;
+                    } else if (name == "pause" && ParseNumber(value, number)) {
+                        pendingPause += std::max(number, 0.0f);
+                        handled = true;
+                    }
+                }
+                if (handled) {
+                    i = close + 1;
+                    continue;
+                }
+            }
+        }
+        const size_t from = i;
+        Char c;
+        c.cp = Utf8::Next(text, i);
+        c.utf8 = std::string(text.substr(from, i - from));
+        current(c);
+        c.pause = pendingPause;
+        pendingPause = 0.0f;
+        out.push_back(std::move(c));
+    }
+    return out;
+}
+
+// 行に分ける（WrapLines と同じ決まり: 英語は単語の区切り、日本語はどこでも）。行 = 文字の番号の並び
+std::vector<std::vector<int>> Wrap(Font& font, const std::vector<Char>& chars, float maxWidth) {
+    std::vector<std::vector<int>> lines;
+    std::vector<int> line;
+    float width = 0.0f;
+    int lastSpace = -1; // line の中の位置
+    auto advance = [&](int idx) { return font.GetGlyph(chars[static_cast<size_t>(idx)].cp).advance; };
+    for (int i = 0; i < static_cast<int>(chars.size()); ++i) {
+        const uint32_t cp = chars[static_cast<size_t>(i)].cp;
+        if (cp == '\n') {
+            lines.push_back(std::move(line));
+            line.clear();
+            width = 0.0f;
+            lastSpace = -1;
+            continue;
+        }
+        if (cp == '\r') continue;
+        const float a = advance(i);
+        if (maxWidth > 0.0f && !line.empty() && width + a > maxWidth) {
+            if (cp != ' ' && lastSpace > 0) {
+                std::vector<int> rest(line.begin() + lastSpace + 1, line.end());
+                line.resize(static_cast<size_t>(lastSpace));
+                lines.push_back(std::move(line));
+                line = std::move(rest);
+                line.push_back(i);
+            } else {
+                lines.push_back(std::move(line));
+                line.clear();
+                if (cp != ' ') line.push_back(i);
+            }
+            width = 0.0f;
+            for (int k : line) width += advance(k);
+            lastSpace = -1;
+        } else {
+            line.push_back(i);
+            width += a;
+        }
+        if (cp == ' ' && !line.empty() && line.back() == i) lastSpace = static_cast<int>(line.size()) - 1;
+    }
+    lines.push_back(std::move(line));
+    return lines;
+}
+
+float Hash(float a, float b) {
+    const float h = std::sin(a * 127.1f + b * 311.7f) * 43758.5453f;
+    return h - std::floor(h);
+}
+
+Vec3 HueToRgb(float h) {
+    h = (h - std::floor(h)) * 6.0f;
+    const float x = 1.0f - std::abs(std::fmod(h, 2.0f) - 1.0f);
+    if (h < 1.0f) return {1.0f, x, 0.0f};
+    if (h < 2.0f) return {x, 1.0f, 0.0f};
+    if (h < 3.0f) return {0.0f, 1.0f, x};
+    if (h < 4.0f) return {0.0f, x, 1.0f};
+    if (h < 5.0f) return {x, 0.0f, 1.0f};
+    return {1.0f, 0.0f, x};
+}
+
+float EaseOutCubic(float t) { return 1.0f - std::pow(1.0f - t, 3.0f); }
+float EaseOutBack(float t) {
+    const float c1 = 1.70158f, c3 = c1 + 1.0f;
+    return 1.0f + c3 * std::pow(t - 1.0f, 3.0f) + c1 * std::pow(t - 1.0f, 2.0f);
+}
+float EaseOutBounce(float t) {
+    const float n1 = 7.5625f, d1 = 2.75f;
+    if (t < 1.0f / d1) return n1 * t * t;
+    if (t < 2.0f / d1) { t -= 1.5f / d1; return n1 * t * t + 0.75f; }
+    if (t < 2.5f / d1) { t -= 2.25f / d1; return n1 * t * t + 0.9375f; }
+    t -= 2.625f / d1;
+    return n1 * t * t + 0.984375f;
+}
+
+bool HasKnownTag(std::string_view text) {
+    return text.find('<') != std::string_view::npos && text.find('>') != std::string_view::npos;
+}
+
+} // namespace
+
+std::string UIText::StripTags(std::string_view text) {
+    if (!HasKnownTag(text)) return std::string(text);
+    std::string out;
+    for (const Char& c : Parse(text, true)) out += c.utf8;
+    return out;
+}
+
+bool UIText::UsesAnimation() const {
+    return effect != TextEffect::None || reveal != TextReveal::None || (richText && HasKnownTag(text));
+}
+
+void UIText::RestartReveal() {
+    m_RevealTime = 0.0f;
+    m_SoundCount = 0;
+    m_RevealDoneSent = false;
+    m_Revealing = reveal != TextReveal::None;
+}
+
+void UIText::SkipReveal() { m_SkipReveal = true; }
+
+void UIText::PaintAnimated(WidgetContext& ctx, const std::string& resolved, float px) {
+    // ---- 時間・出し直し ----
+    const double now = Platform::GetTime();
+    const bool shownAgain = now - m_LastPaint > kShownAgainAfter;
+    m_LastPaint = now;
+    if (resolved != m_RevealText || (shownAgain && revealOnShow)) {
+        m_RevealText = resolved;
+        RestartReveal();
+    }
+    const float dt = std::clamp(ctx.deltaTime, 0.0f, 0.25f);
+    m_EffectTime += dt;
+    if (revealAuto) m_RevealTime += dt;
+    if (m_SkipReveal) {
+        m_RevealTime = 1e6f;
+        m_SkipReveal = false;
+    }
+
+    const std::vector<Char> chars = Parse(resolved, richText);
+    auto f = ctx.GetFont(font, px);
+    if (!f || chars.empty()) {
+        m_Revealing = false;
+        return;
+    }
+
+    // ---- 1 文字ずつの出る時刻 ----
+    const int n = static_cast<int>(chars.size());
+    std::vector<float> start(static_cast<size_t>(n), 0.0f);
+    {
+        float t = revealDelay;
+        const float step = 1.0f / std::max(revealSpeed, 0.01f);
+        for (int i = 0; i < n; ++i) {
+            t += chars[static_cast<size_t>(i)].pause;
+            start[static_cast<size_t>(i)] = t;
+            if (chars[static_cast<size_t>(i)].cp != '\n') t += step / chars[static_cast<size_t>(i)].speed;
+        }
+    }
+    const bool revealing = reveal != TextReveal::None && !(ctx.designMode && revealAuto);
+    const float fade = std::max(revealFade, 0.0f);
+    // 文字 i の出かた（0: まだ / 1: 出きった）
+    auto progressOf = [&](int i) {
+        if (!revealing) return 1.0f;
+        float t;
+        if (revealAuto) {
+            t = m_RevealTime - start[static_cast<size_t>(i)];
+        } else {
+            // revealProgress（0〜1）で何文字目まで出すか（タイムラインで動かす）
+            t = (std::clamp(revealProgress, 0.0f, 1.0f) * static_cast<float>(n) - static_cast<float>(i)) * std::max(fade, 1e-3f);
+        }
+        if (t < 0.0f) return 0.0f;
+        if (reveal == TextReveal::Typewriter || fade <= 0.0f) return 1.0f;
+        return std::clamp(t / fade, 0.0f, 1.0f);
+    };
+
+    // ---- 出した文字の音・出し終えたとき ----
+    int shown = 0;
+    for (int i = 0; i < n; ++i) {
+        if (progressOf(i) > 0.0f) shown = i + 1;
+    }
+    const bool done = !revealing || (shown >= n && progressOf(n - 1) >= 1.0f);
+    m_Revealing = revealing && !done;
+    if (revealing && !ctx.designMode) {
+        if (!revealSound.empty() && shown > m_SoundCount) {
+            // 1 フレームに 1 回まで鳴らす（空白・改行では鳴らさない）
+            bool play = false;
+            for (int i = m_SoundCount; i < shown; ++i) {
+                const uint32_t cp = chars[static_cast<size_t>(i)].cp;
+                if (cp == ' ' || cp == '\n' || cp == 0x3000) continue;
+                if (i % std::max(revealSoundEvery, 1) == 0) play = true;
+            }
+            if (play) {
+                if (auto clip = Assets::GetAudioClip(revealSound)) Audio::PlayOneShot(clip);
+            }
+        }
+        if (done && !m_RevealDoneSent) ctx.Emit({UIEventType::TextRevealed, name, name, 1.0f, StripTags(resolved), this});
+    }
+    m_SoundCount = std::max(m_SoundCount, shown);
+    if (done) m_RevealDoneSent = true;
+
+    // ---- 並べる ----
+    const UI::Rect& R = m_ScreenRect;
+    const auto lines = Wrap(*f, chars, wrap ? R.w + 1.0f : -1.0f);
+    const float lh = f->GetLineHeight();
+    const float total = lh * static_cast<float>(lines.size());
+    float y = R.y;
+    if (lines.size() == 1 && verticalAlign == TextVAlign::Center) y = std::round(R.y + R.h * 0.5f + f->GetVisualCenter() - f->GetAscent());
+    else if (verticalAlign == TextVAlign::Center) y = R.y + (R.h - total) * 0.5f;
+    else if (verticalAlign == TextVAlign::Bottom) y = R.Bottom() - total;
+
+    const float s = m_ScreenScale.y;
+    const float strength = effectStrength * s;
+    const float time = m_EffectTime * effectSpeed;
+    const uint32_t baseEffects = EffectBitOf(effect);
+
+    struct Placed {
+        int index;
+        Vec2 center;
+        Vec2 size;
+        float rotation;
+        float scale;
+        Vec4 color;
+        Glyph glyph;
+    };
+    std::vector<Placed> placed;
+    placed.reserve(chars.size());
+    for (const auto& line : lines) {
+        float w = 0.0f;
+        for (int i : line) w += f->GetGlyph(chars[static_cast<size_t>(i)].cp).advance;
+        float x = R.x;
+        if (align == TextAlign::Center) x = R.x + (R.w - w) * 0.5f;
+        else if (align == TextAlign::Right) x = R.Right() - w;
+        x = std::round(x);
+        const float baseline = std::round(y + f->GetAscent());
+        for (int i : line) {
+            const Char& c = chars[static_cast<size_t>(i)];
+            const Glyph& g = f->GetGlyph(c.cp);
+            const float p = progressOf(i);
+            if (g.size.x > 0.0f && g.size.y > 0.0f && p > 0.0f) {
+                Placed pl{i, {x + g.offset.x + g.size.x * 0.5f, baseline + g.offset.y + g.size.y * 0.5f}, g.size, 0.0f, 1.0f, c.hasColor ? c.color : color, g};
+                pl.color.w *= c.alpha;
+                // 出かた
+                switch (reveal) {
+                case TextReveal::Fade: pl.color.w *= p; break;
+                case TextReveal::Pop:
+                    pl.scale = EaseOutBack(p);
+                    pl.color.w *= std::min(1.0f, p * 3.0f);
+                    break;
+                case TextReveal::Rise:
+                    pl.center.y += (1.0f - EaseOutCubic(p)) * lh * 0.6f;
+                    pl.color.w *= p;
+                    break;
+                case TextReveal::Drop:
+                    pl.center.y -= (1.0f - EaseOutBounce(p)) * lh;
+                    pl.color.w *= std::min(1.0f, p * 4.0f);
+                    break;
+                case TextReveal::Spin:
+                    pl.rotation = (1.0f - EaseOutCubic(p)) * kPi;
+                    pl.scale = EaseOutCubic(p);
+                    pl.color.w *= p;
+                    break;
+                default: break;
+                }
+                // ずっと続く動き
+                const uint32_t fx = baseEffects | c.effects;
+                const float fi = static_cast<float>(i);
+                if (fx & kWave) pl.center.y += std::sin(time * 6.0f - fi * 0.45f) * strength;
+                if (fx & kShake) {
+                    const float tick = std::floor(time * 24.0f);
+                    pl.center.x += (Hash(fi, tick) - 0.5f) * strength;
+                    pl.center.y += (Hash(fi + 31.0f, tick) - 0.5f) * strength;
+                }
+                if (fx & kPulse) pl.scale *= 1.0f + 0.15f * std::sin(time * 5.0f - fi * 0.3f) * (effectStrength / 6.0f);
+                if (fx & kSwing) pl.rotation += std::sin(time * 4.0f - fi * 0.5f) * 0.25f * (effectStrength / 6.0f);
+                if (fx & kRainbow) {
+                    const Vec3 rgb = HueToRgb(time * 0.4f + fi * 0.07f);
+                    pl.color = {rgb.x, rgb.y, rgb.z, pl.color.w};
+                }
+                if (fx & kGlitch) {
+                    const float tick = std::floor(time * 10.0f);
+                    if (Hash(fi, tick) > 0.86f) {
+                        pl.center.x += (Hash(fi + 7.0f, tick) - 0.5f) * strength * 2.0f;
+                        const Vec3 rgb = HueToRgb(Hash(fi + 3.0f, tick));
+                        pl.color = {pl.color.x * 0.4f + rgb.x * 0.6f, pl.color.y * 0.4f + rgb.y * 0.6f, pl.color.z * 0.4f + rgb.z * 0.6f, pl.color.w};
+                    }
+                }
+                placed.push_back(pl);
+            }
+            x += g.advance;
+        }
+        y += lh;
+    }
+
+    // ---- 描く（影 → 文字） ----
+    auto drawAll = [&](const Vec2& offset, const Vec4* override) {
+        for (const Placed& pl : placed) {
+            const Glyph& g = pl.glyph;
+            Vec4 tint = override ? Vec4{override->x, override->y, override->z, override->w * (pl.color.w / std::max(color.w, 1e-3f))} : pl.color;
+            if (!override && g.colored) tint = {1.0f, 1.0f, 1.0f, tint.w};
+            tint = ctx.Fade(tint);
+            if (tint.w <= 0.001f) continue;
+            const Mat4 m = Mat4::Translate({pl.center.x + offset.x, pl.center.y + offset.y, 0.0f}) * Mat4::RotateZ(pl.rotation) *
+                           Mat4::Scale({pl.size.x * pl.scale, pl.size.y * pl.scale, 1.0f});
+            Renderer2D::DrawTransformedQuad(m, tint, f->GetAtlas(g.page), g.uvMin, g.uvMax);
+        }
+    };
+    if (shadow) drawAll({shadowOffset.x * m_ScreenScale.x, shadowOffset.y * m_ScreenScale.y}, &shadowColor);
+    drawAll({0.0f, 0.0f}, nullptr);
+}
+
+} // namespace Ruto
