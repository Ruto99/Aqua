diff --git a/Modules/Engine/src/WidgetCapture.cpp b/Modules/Engine/src/WidgetCapture.cpp
new file mode 100644
index 0000000..0d722c5
--- /dev/null
+++ b/Modules/Engine/src/WidgetCapture.cpp
@@ -0,0 +1,136 @@
+// ウィジェット UI: キャプチャー（ゲームの画面を撮って、その場に貼る）
+//
+//   ポーズ画面・メニューの背景に、止めたゲームの画面を出すためのもの。
+//   撮った画面は GPU のテクスチャに持つだけで、ファイルには書かない（UI を閉じる・作り直すと消える）。
+//   描くときに、それまでに描かれたもの（ゲームの画面・このウィジェットより後ろの UI）をテクスチャへ写す。
+//   ぼかしは半分ずつ縮めたテクスチャをなめらかに引き伸ばして作る（シェーダーを使わない）。
+
+#include "Ruto/Engine/Widgets.h"
+
+#include "Ruto/Engine/Assets.h"
+#include "Ruto/Graphics/RenderCommand.h"
+#include "Ruto/Graphics/Renderer2D.h"
+#include "Ruto/Graphics/Texture.h"
+#include "Ruto/Platform/Platform.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace Ruto {
+
+namespace {
+
+constexpr const char* const kCaptureTiming[] = {"OnShow", "EveryFrame", "Script"};
+constexpr const char* const kCaptureArea[] = {"Screen", "Behind"};
+constexpr int kMaxBlurSteps = 6;       // 1 / 64 まで縮める
+constexpr double kShownAgainAfter = 0.25; // これより長く描かれなかったら「表示し直した」とみなして撮り直す
+
+std::shared_ptr<Texture> MakeTarget(int w, int h) {
+    return std::make_shared<Texture>(std::max(w, 1), std::max(h, 1), nullptr, TextureFilter::Linear, TextureWrap::Clamp);
+}
+
+} // namespace
+
+void UICapture::Reflect(PropertyVisitor& v) {
+    v.EnumField("timing", timing, kCaptureTiming);
+    v.EnumField("area", area, kCaptureArea);
+    v.Color("color", color);
+    v.Range("blur", blur, 0.0f, 1.0f);
+    v.Property("blockInput", blockInput);
+    v.Property("size", size);
+    v.Header("デザイン");
+    v.Asset("previewTexture", previewTexture, AssetType::Texture);
+}
+
+Vec2 UICapture::ComputeDesiredSize(WidgetContext&, float) { return size; }
+
+void UICapture::ReleaseCapture() {
+    m_Captured.reset();
+    m_Blur.clear();
+    m_Display.reset();
+    m_BlurSteps = -1;
+}
+
+void UICapture::Grab(const UI::Rect& screenRect) {
+    // ここまでに積んだ四角形（後ろの UI）を描いてから写す
+    Renderer2D::Flush();
+    const Vec2 screen = UI::GetScreenSize();
+    const int sw = static_cast<int>(std::lround(screen.x)), sh = static_cast<int>(std::lround(screen.y));
+    if (sw <= 0 || sh <= 0) return;
+    int x0 = 0, y0 = 0, x1 = sw, y1 = sh; // UI の座標（左上が原点）
+    if (area == CaptureArea::Behind) {
+        x0 = std::clamp(static_cast<int>(std::floor(screenRect.x)), 0, sw);
+        y0 = std::clamp(static_cast<int>(std::floor(screenRect.y)), 0, sh);
+        x1 = std::clamp(static_cast<int>(std::ceil(screenRect.Right())), 0, sw);
+        y1 = std::clamp(static_cast<int>(std::ceil(screenRect.Bottom())), 0, sh);
+    }
+    const int w = x1 - x0, h = y1 - y0;
+    if (w <= 0 || h <= 0) return;
+    if (!m_Captured) m_Captured = MakeTarget(w, h);
+    // 描画先は左下が原点なので上下を返す
+    if (!RenderCommand::CopyFramebufferToTexture(*m_Captured, x0, sh - y1, w, h)) return;
+    m_BlurSteps = -1; // ぼかしを作り直す
+}
+
+void UICapture::UpdateBlur() {
+    // ぼかし: 半分ずつ縮める（線形補間で 2×2 の平均になる）。blur が変わったら撮り直さずに作り直す
+    const int steps = std::clamp(static_cast<int>(std::lround(blur * kMaxBlurSteps)), 0, kMaxBlurSteps);
+    if (!m_Captured || steps == m_BlurSteps) return;
+    m_BlurSteps = steps;
+    m_Display = m_Captured;
+    int bw = m_Captured->GetWidth(), bh = m_Captured->GetHeight();
+    for (int i = 0; i < steps && bw > 1 && bh > 1; ++i) {
+        bw = std::max(1, bw / 2);
+        bh = std::max(1, bh / 2);
+        if (static_cast<int>(m_Blur.size()) <= i) m_Blur.push_back(MakeTarget(bw, bh));
+        Texture& level = *m_Blur[static_cast<size_t>(i)];
+        if (level.GetWidth() != bw || level.GetHeight() != bh) level.SetData(bw, bh, nullptr);
+        RenderCommand::BlitTexture(*m_Display, level);
+        m_Display = m_Blur[static_cast<size_t>(i)];
+    }
+}
+
+void UICapture::Paint(WidgetContext& ctx) {
+    const UI::Rect& R = m_ScreenRect;
+    if (R.w <= 0.0f || R.h <= 0.0f) return;
+    if (ctx.designMode) {
+        // デザイン中: ゲームの画面は無いので、見本の画像か模様を出す
+        if (auto tex = previewTexture.empty() ? nullptr : Assets::GetTexture(previewTexture)) {
+            ctx.DrawImage(R, tex, ctx.Fade(color));
+        } else {
+            ctx.FillRect(R, ctx.Fade({0.22f * color.x, 0.26f * color.y, 0.34f * color.z, color.w}));
+            const float s = std::max(m_ScreenScale.y, 0.01f);
+            const float px = std::clamp(R.h * 0.06f, 12.0f * s, 40.0f * s);
+            ctx.DrawText(R, "キャプチャー（ゲームの画面がここに入ります）", "", px, ctx.Fade({1.0f, 1.0f, 1.0f, 0.55f}), TextAlign::Center,
+                         TextVAlign::Center, true);
+        }
+        if (blockInput && visibility == WidgetVisibility::Visible) UI::HoverRect(R);
+        return;
+    }
+
+    const double now = Platform::GetTime();
+    const bool shownAgain = now - m_LastPaint > kShownAgainAfter;
+    m_LastPaint = now;
+    bool grab = m_Request;
+    if (timing == CaptureTiming::EveryFrame) grab = true;
+    if (timing == CaptureTiming::OnShow && (shownAgain || !m_Captured)) grab = true;
+    if (grab) {
+        m_Request = false;
+        Grab(R);
+    }
+    UpdateBlur();
+    if (m_Display) {
+        UI::Rect dst = R;
+        if (area == CaptureArea::Behind) {
+            // 画面の外にはみ出した分は撮れていないので、撮れた範囲に描く
+            const Vec2 screen = UI::GetScreenSize();
+            const float x0 = std::clamp(std::floor(R.x), 0.0f, screen.x), y0 = std::clamp(std::floor(R.y), 0.0f, screen.y);
+            const float x1 = std::clamp(std::ceil(R.Right()), 0.0f, screen.x), y1 = std::clamp(std::ceil(R.Bottom()), 0.0f, screen.y);
+            dst = {x0, y0, x1 - x0, y1 - y0};
+        }
+        ctx.DrawImage(dst, m_Display, ctx.Fade(color));
+    }
+    if (blockInput && visibility == WidgetVisibility::Visible && opacity > 0.01f) UI::HoverRect(R);
+}
+
+} // namespace Ruto
