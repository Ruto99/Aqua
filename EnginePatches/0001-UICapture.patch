+// ゲームの画面を撮って、その場に貼る（ポーズ・メニューの背景など）
+//   撮った画面はテクスチャ（GPU のメモリ）に持つだけで、ファイルには書かない。
+//   このウィジェットより先に描かれたもの（ゲームの画面・後ろの UI）が写る。
+//   デザイナーでは previewTexture（なければ見本の模様）を表示する。
+enum class CaptureTiming { OnShow, EveryFrame, Script };
+enum class CaptureArea { Screen, Behind };
+
+class UICapture : public Widget {
+    RUTO_WIDGET(UICapture)
+    CaptureTiming timing = CaptureTiming::OnShow; // OnShow: 表示したときに 1 回（止まった画面）/ EveryFrame: 毎フレーム / Script: Capture() を呼んだとき
+    CaptureArea area = CaptureArea::Screen;       // Screen: 画面全体を撮って広げる / Behind: このウィジェットの後ろだけ（すりガラス風）
+    Vec4 color{1.0f, 1.0f, 1.0f, 1.0f};           // 掛ける色（0.5 の灰色で暗くするなど）
+    float blur = 0.0f;                            // ぼかし（0〜1）
+    std::string previewTexture;                   // デザイン中だけ代わりに表示する画像（ゲームでは使わない）
+    bool blockInput = true;                       // マウスを受け止めて、後ろの UI・ゲームに通さない
+    Vec2 size{1920.0f, 1080.0f};                  // 中身として必要な大きさ（Box の中で使う）
+
+    // 次に描くときに撮り直す（timing が Script のときはこれで撮る）
+    void Capture() { m_Request = true; }
+    // 撮った画面（まだ撮っていなければ nullptr）。ほかの画像・スクリプトでも使える
+    const std::shared_ptr<Texture>& GetCapturedTexture() const { return m_Captured; }
+    // 撮った画面を手放す（timing が Script なら、次に Capture() するまで何も表示しない）
+    void ReleaseCapture();
+
+    bool HasHitArea() const override { return blockInput; }
+    void Reflect(PropertyVisitor& v) override;
+    Vec2 ComputeDesiredSize(WidgetContext& ctx, float maxWidth) override;
+    void Paint(WidgetContext& ctx) override;
+
+private:
+    void Grab(const UI::Rect& screenRect);
+    void UpdateBlur();
+
+    std::shared_ptr<Texture> m_Captured;            // 撮ったそのまま
+    std::vector<std::shared_ptr<Texture>> m_Blur;   // ぼかし用に半分ずつ縮めたもの
+    std::shared_ptr<Texture> m_Display;             // 表示するもの（m_Captured か m_Blur の最後）
+    int m_BlurSteps = -1;                           // m_Blur を作ったときのぼかしの段数
+    bool m_Request = false;
+    double m_LastPaint = -100.0;
+};
+
 enum class ButtonTransition { ColorTint, None };
 
