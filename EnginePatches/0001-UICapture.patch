+++ b/Modules/Graphics/src/RenderCommand.cpp
@@ -1,6 +1,7 @@
 #include "Ruto/Graphics/RenderCommand.h"
 
 #include "GL.h"
+#include "Ruto/Graphics/Texture.h"
 
 namespace Ruto {
 
@@ -24,4 +25,63 @@ void RenderCommand::ClearRect(int x, int y, int width, int height, const Vec4& c
     glDisable(GL_SCISSOR_TEST);
 }
 
+namespace {
+
+// 写すときだけ使うフレームバッファ（読む側・書く側。最初に使うときに作る）
+GLuint s_CopyRead = 0;
+GLuint s_CopyDraw = 0;
+
+void EnsureCopyFramebuffers() {
+    if (!s_CopyRead) glGenFramebuffers(1, &s_CopyRead);
+    if (!s_CopyDraw) glGenFramebuffers(1, &s_CopyDraw);
+}
+
+// 今の読み書きの描画先・シザーを覚えておいて戻す
+struct FramebufferState {
+    GLint read = 0, draw = 0, scissor = 0;
+    FramebufferState() {
+        glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+        glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+        glGetIntegerv(GL_SCISSOR_TEST, &scissor);
+        if (scissor) glDisable(GL_SCISSOR_TEST); // 写すときにシザーで切られないように
+    }
+    ~FramebufferState() {
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(read));
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, static_cast<GLuint>(draw));
+        if (scissor) glEnable(GL_SCISSOR_TEST);
+    }
+};
+
+} // namespace
+
+bool RenderCommand::CopyFramebufferToTexture(Texture& dst, int x, int y, int width, int height) {
+    if (width <= 0 || height <= 0) return false;
+    if (dst.GetWidth() != width || dst.GetHeight() != height) dst.SetData(width, height, nullptr);
+    EnsureCopyFramebuffers();
+    FramebufferState state;
+    // 読む側は今の描画先のまま、書く側だけ dst を付けたフレームバッファにする
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(state.draw));
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, s_CopyDraw);
+    glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, dst.GetId(), 0);
+    const bool ok = glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+    // 同じ大きさで写す（MSAA の画面からはこのとき 1 サンプルにまとめられる）
+    if (ok) glBlitFramebuffer(x, y, x + width, y + height, 0, 0, width, height, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0, 0);
+    return ok;
+}
+
+void RenderCommand::BlitTexture(const Texture& src, Texture& dst) {
+    if (src.GetWidth() <= 0 || dst.GetWidth() <= 0) return;
+    EnsureCopyFramebuffers();
+    FramebufferState state;
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, s_CopyRead);
+    glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, src.GetId(), 0);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, s_CopyDraw);
+    glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, dst.GetId(), 0);
+    if (glCheckFramebufferStatus(GL_READ_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE && glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE)
+        glBlitFramebuffer(0, 0, src.GetWidth(), src.GetHeight(), 0, 0, dst.GetWidth(), dst.GetHeight(), GL_COLOR_BUFFER_BIT, GL_LINEAR);
+    glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0, 0);
+    glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0, 0);
+}
+
 } // namespace Ruto
