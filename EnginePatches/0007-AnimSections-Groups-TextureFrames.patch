+
+bool WidgetAsset::ResolvePlayable(std::string_view name, const WidgetAnimation*& anim, float& start, float& end, bool& loop) const {
+    if (const WidgetAnimation* a = FindAnimation(name)) {
+        anim = a;
+        start = 0.0f;
+        end = a->GetDuration();
+        loop = false;
+        return true;
+    }
+    for (const WidgetAnimation& a : animations) {
+        if (const WidgetAnimSection* sec = a.FindSection(name)) {
+            anim = &a;
+            start = std::max(sec->start, 0.0f);
+            end = std::max(sec->end, start);
+            loop = sec->loop;
+            return true;
+        }
+    }
+    return false;
+}
