+std::string UIImage::CurrentTexture() const {
+    if (frames.empty()) return texture;
+    std::vector<std::string_view> list;
+    std::string_view rest = frames;
+    while (!rest.empty()) {
+        const size_t nl = rest.find('\n');
+        std::string_view line = rest.substr(0, nl);
+        rest = nl == std::string_view::npos ? std::string_view() : rest.substr(nl + 1);
+        while (!line.empty() && (line.front() == ' ' || line.front() == '\t')) line.remove_prefix(1);
+        while (!line.empty() && (line.back() == ' ' || line.back() == '\t' || line.back() == '\r')) line.remove_suffix(1);
+        if (!line.empty()) list.push_back(line);
+    }
+    if (list.empty()) return texture;
+    int index = frame;
+    if (framesPerSecond > 0.0f) index += static_cast<int>(std::floor(m_FrameTime * framesPerSecond));
+    const int n = static_cast<int>(list.size());
+    index = ((index % n) + n) % n;
+    return std::string(list[static_cast<size_t>(index)]);
+}
