+// ---------------------------------------------------------------------------
+// 自作の文字アニメーション
+// ---------------------------------------------------------------------------
+
+float TextCharAnimation::DefaultValue(std::string_view property) {
+    return property.starts_with("offset") || property == "rotation" ? 0.0f : 1.0f;
+}
+
+TimelineCurve* TextCharAnimation::Find(std::string_view property) {
+    for (TimelineCurve& c : curves) {
+        if (c.property == property) return &c;
+    }
+    return nullptr;
+}
+
+const TimelineCurve* TextCharAnimation::Find(std::string_view property) const {
+    for (const TimelineCurve& c : curves) {
+        if (c.property == property) return &c;
+    }
+    return nullptr;
+}
+
+bool TextCharAnimation::IsEmpty() const {
+    return std::all_of(curves.begin(), curves.end(), [](const TimelineCurve& c) { return c.keys.empty(); });
+}
+
+float TextCharAnimation::GetDuration() const {
+    float d = 0.0f;
+    for (const TimelineCurve& c : curves) d = std::max(d, c.GetEndTime());
+    return d;
+}
+
+TextCharAnimation::Sample TextCharAnimation::Evaluate(float time) const {
+    Sample s;
+    float scale = 1.0f;
+    for (const TimelineCurve& c : curves) {
+        if (c.keys.empty()) continue;
+        const float v = c.Evaluate(time);
+        const std::string& p = c.property;
+        if (p == "offset.x") s.offset.x = v;
+        else if (p == "offset.y") s.offset.y = v;
+        else if (p == "scale") scale = v;
+        else if (p == "scale.x") s.scale.x = v;
+        else if (p == "scale.y") s.scale.y = v;
+        else if (p == "rotation") s.rotation = v;
+        else if (p == "alpha") s.color.w = v;
+        else if (p == "color.r") s.color.x = v;
+        else if (p == "color.g") s.color.y = v;
+        else if (p == "color.b") s.color.z = v;
+    }
+    s.scale = {s.scale.x * scale, s.scale.y * scale};
+    return s;
+}
+
+std::string TextCharAnimation::ToString() const {
+    Json j = Json::MakeObject();
+    j["pivot"] = pivot;
+    j["charDelay"] = charDelay;
+    Json cj = Json::MakeObject();
+    for (const TimelineCurve& c : curves) {
+        if (c.keys.empty()) continue;
+        Json keys = Json::MakeArray();
+        for (const TimelineKey& k : c.keys) {
+            Json kj = Json::MakeArray();
+            kj.Push(std::round(k.time * 10000.0) / 10000.0);
+            kj.Push(std::round(k.value * 10000.0) / 10000.0);
+            kj.Push(static_cast<int>(k.interpolation));
+            keys.Push(std::move(kj));
+        }
+        cj[c.property] = std::move(keys);
+    }
+    j["curves"] = std::move(cj);
+    return j.Dump(0);
+}
+
+TextCharAnimation TextCharAnimation::Parse(std::string_view json) {
+    TextCharAnimation a;
+    if (json.empty()) return a;
+    const std::optional<Json> parsed = Json::Parse(json);
+    if (!parsed || !parsed->IsObject()) return a;
+    const Json& j = *parsed;
+    a.pivot = static_cast<float>(j["pivot"].AsNumber(0.5));
+    a.charDelay = static_cast<float>(j["charDelay"].AsNumber(0.08));
+    for (const auto& [property, keys] : j["curves"].Items()) {
+        TimelineCurve c;
+        c.property = property;
+        for (const Json& kj : keys.Elements()) {
+            TimelineKey k;
+            k.time = std::max(static_cast<float>(kj.At(0).AsNumber()), 0.0f);
+            k.value = static_cast<float>(kj.At(1).AsNumber());
+            const int interp = kj.At(2).AsInt(0);
+            k.interpolation = interp >= 0 && interp <= 2 ? static_cast<KeyInterpolation>(interp) : KeyInterpolation::Smooth;
+            c.keys.push_back(k);
+        }
+        c.Sort();
+        a.curves.push_back(std::move(c));
+    }
+    return a;
+}
