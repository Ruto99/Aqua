+    float pivot = 0.5f;      // 回転・拡大の中心の高さ（0: 文字の上・0.5: 中央・1: 下）
+    float charDelay = 0.08f; // ずっと続く動き: 隣の文字とずらす秒（0 なら全部の文字が同時に動く）
+
+    struct Sample {
+        Vec2 offset{0.0f, 0.0f};
+        Vec2 scale{1.0f, 1.0f};
+        float rotation = 0.0f; // 度
+        Vec4 color{1.0f, 1.0f, 1.0f, 1.0f};
+    };
+    Sample Evaluate(float time) const;
+    float GetDuration() const; // いちばん後ろのキーの時刻
+    bool IsEmpty() const;
+    TimelineCurve* Find(std::string_view property);
+    const TimelineCurve* Find(std::string_view property) const;
+    // その値のキーが無いときの値（ずれ・回転は 0、ほかは 1）
+    static float DefaultValue(std::string_view property);
+    std::string ToString() const;
+    static TextCharAnimation Parse(std::string_view json);
+};
