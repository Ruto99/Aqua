+    if (!m_Asset || !m_Asset->ResolvePlayable(name, anim, start, end, sectionLoop)) return;
+    time = std::clamp(time, 0.0f, end - start);
+    for (PlayingAnim& p : m_Playing) {
+        if (p.name == name) p.time = time;
+    }
+    if (m_Root) EvaluateAnimation(name, time);
+}
+
+float WidgetDocument::GetAnimationTime(std::string_view name) const {
+    for (const PlayingAnim& p : m_Playing) {
+        if (p.name == name) return p.time;
