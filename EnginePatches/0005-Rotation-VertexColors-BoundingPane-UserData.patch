+}
+
+void UIBoundingPane::OnPointerUp(WidgetContext& ctx, bool inside) {
+    if (!inside || !enabled) return;
+    UIEvent e;
+    e.type = UIEventType::Click;
+    e.widget = name;
+    e.message = clickMessage.empty() ? name : clickMessage;
+    e.source = this;
+    ctx.Emit(std::move(e));
 }
 
