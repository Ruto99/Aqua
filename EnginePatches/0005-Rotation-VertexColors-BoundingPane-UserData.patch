+namespace {
+// userData の「キー=値」の行からキーを探す
+bool FindUserData(std::string_view data, std::string_view key, std::string_view& value) {
+    auto trim = [](std::string_view s) {
+        while (!s.empty() && (s.front() == ' ' || s.front() == '\t')) s.remove_prefix(1);
+        while (!s.empty() && (s.back() == ' ' || s.back() == '\t' || s.back() == '\r')) s.remove_suffix(1);
+        return s;
+    };
+    size_t start = 0;
+    while (start <= data.size()) {
+        size_t end = data.find('\n', start);
+        if (end == std::string_view::npos) end = data.size();
+        const std::string_view line = data.substr(start, end - start);
+        if (const size_t eq = line.find('='); eq != std::string_view::npos && trim(line.substr(0, eq)) == key) {
+            value = trim(line.substr(eq + 1));
+            return true;
+        }
+        start = end + 1;
+    }
+    return false;
+}
+} // namespace
+
+std::string Widget::GetUserData(std::string_view key, std::string_view fallback) const {
+    std::string_view v;
+    return std::string(FindUserData(userData, key, v) ? v : fallback);
+}
+
+float Widget::GetUserDataFloat(std::string_view key, float fallback) const {
+    std::string_view v;
+    if (!FindUserData(userData, key, v)) return fallback;
+    try {
+        return std::stof(std::string(v));
+    } catch (...) {
+        return fallback;
+    }
+}
+
+bool Widget::HasUserData(std::string_view key) const {
+    std::string_view v;
+    return FindUserData(userData, key, v);
+}
+
+Vec2 Widget::ScreenToLayout(const Vec2& p) const {
+    if (!m_HasXform) return p;
+    const Vec4 q = m_InvXform * Vec4{p.x, p.y, 0.0f, 1.0f};
+    return {q.x, q.y};
+}
