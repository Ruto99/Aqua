-std::vector<std::string> WrapLines(Font& font, std::string_view text, float maxWidth) {
+// 1 行の幅（文字間を足したもの）
+float LineWidth(Font& font, std::string_view line, float letterSpacing) {
+    float w = font.MeasureText(line).x;
+    if (letterSpacing != 0.0f) {
+        int count = 0;
+        size_t i = 0;
+        while (i < line.size()) {
+            Utf8::Next(line, i);
+            ++count;
+        }
+        if (count > 1) w += letterSpacing * static_cast<float>(count - 1);
+    }
+    return w;
+}
+
+// 文字間を空けて 1 行を描く（空けなければ Renderer2D::DrawText と同じ）
+void DrawLine(Font& font, std::string_view line, Vec2 pos, const Vec4& color, float letterSpacing) {
+    if (letterSpacing == 0.0f) {
+        Renderer2D::DrawText(font, line, pos, color);
+        return;
+    }
+    size_t i = 0;
+    while (i < line.size()) {
+        const size_t from = i;
+        Utf8::Next(line, i);
+        pos.x += Renderer2D::DrawText(font, line.substr(from, i - from), {std::round(pos.x), pos.y}, color) + letterSpacing;
+    }
+}
+
+std::vector<std::string> WrapLines(Font& font, std::string_view text, float maxWidth, float letterSpacing = 0.0f) {
     std::vector<std::string> lines;
     size_t start = 0;
     while (start <= text.size()) {
@@ -124,7 +153,7 @@ std::vector<std::string> WrapLines(Font& font, std::string_view text, float maxW
                 const uint32_t cp = Utf8::Next(para, i);
                 const std::string ch(para.substr(from, i - from));
                 std::string candidate = line + ch;
-                if (!line.empty() && font.MeasureText(candidate).x > maxWidth) {
