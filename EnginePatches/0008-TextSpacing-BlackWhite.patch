+            ctx.DrawText(sr, resolved, font, px, ctx.Fade(shadowColor), align, verticalAlign, wrap, ls, lsp);
+        }
+        const Vec4 grad[2] = {gradientTop, gradientBottom};
+        ctx.DrawText(m_ScreenRect, resolved, font, px, ctx.Fade(color), align, verticalAlign, wrap, ls, lsp, gradient ? grad : nullptr);
     }
-    if (shadow) {
