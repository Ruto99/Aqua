                         lines.push_back(line.substr(0, lastSpace));
@@ -266,27 +295,30 @@ std::shared_ptr<Font> WidgetContext::GetFont(const std::string& font, float pixe
     return f;
 }
 
-Vec2 WidgetContext::MeasureText(std::string_view text, const std::string& font, float size, float wrapWidth) const {
+Vec2 WidgetContext::MeasureText(std::string_view text, const std::string& font, float size, float wrapWidth, float letterSpacing,
+                                float lineSpacing) const {
     // 実際に描く大きさのフォントで測って、基準解像度の単位に戻す（描画と同じ結果になる）
     const float k = std::max(scale, 0.01f);
     auto f = GetFont(font, size * k);
     if (!f) return {text.size() * size * 0.5f, size};
     if (text.empty()) return {0.0f, f->GetLineHeight() / k};
-    const auto lines = WrapLines(*f, text, wrapWidth > 0.0f ? wrapWidth * k : -1.0f);
+    const float ls = letterSpacing * k;
+    const auto lines = WrapLines(*f, text, wrapWidth > 0.0f ? wrapWidth * k : -1.0f, ls);
     float w = 0.0f;
-    for (const std::string& line : lines) w = std::max(w, f->MeasureText(line).x);
-    return {w / k, f->GetLineHeight() * static_cast<float>(lines.size()) / k};
+    for (const std::string& line : lines) w = std::max(w, LineWidth(*f, line, ls));
+    const float n = static_cast<float>(lines.size());
+    return {w / k, (f->GetLineHeight() * n + lineSpacing * k * std::max(n - 1.0f, 0.0f)) / k};
 }
 
