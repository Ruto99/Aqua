+    if (shrinkToFit && fontSize > 0.0f) {
+        // 枠に入りきらなければ小さくする（基準解像度の単位で測る）
+        const Vec2 m = ctx.MeasureText(richText ? StripTags(resolved) : resolved, font, fontSize, wrap ? m_Rect.w : -1.0f, letterSpacing, lineSpacing);
+        float k = 1.0f;
