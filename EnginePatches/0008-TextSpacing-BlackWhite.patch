+            Renderer2D::SetCornerColors({x, y, std::max(w, 1.0f), f->GetLineHeight()}, colors);
+        }
+        DrawLine(*f, line, {std::round(x), std::round(y)}, color, letterSpacing);
         y += lh;
     }
+    if (gradient) Renderer2D::ClearCornerColors();
 }
 
